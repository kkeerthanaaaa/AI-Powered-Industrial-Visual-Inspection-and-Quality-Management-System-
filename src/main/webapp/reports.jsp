<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ page import="com.industrialinspection.model.QualityReport" %>
<%@ page import="com.industrialinspection.model.User" %>
<%@ page import="com.industrialinspection.model.enums.ReportType" %>
<%@ page import="com.industrialinspection.util.DateTimeUtil" %>
<%@ page import="java.util.List" %>
<%
    request.setAttribute("activePage", "reports");
    ReportType[] reportTypes = (ReportType[]) request.getAttribute("reportTypes");
    List<QualityReport> reports = (List<QualityReport>) request.getAttribute("reports");
    User currentUser = (User) session.getAttribute("currentUser");
%>
<jsp:include page="/WEB-INF/includes/header.jsp" />

<div class="page-header">
    <div>
        <h1 class="page-title">Quality &amp; Operational Analytics Reports</h1>
        <div class="page-desc">Export formal industrial quality compliance, yield, and inspection logs</div>
    </div>
</div>

<div class="card" style="margin-bottom: 25px;">
    <h3 style="margin-top:0; color: var(--accent-cyan);">Generate New Quality Audit Report</h3>
    <form method="POST" action="<%= request.getContextPath() %>/reports" style="display: flex; gap: 15px; flex-wrap: wrap; align-items: flex-end;">
        <div class="form-group" style="flex: 2; min-width: 250px; margin-bottom: 0;">
            <label>Report Template</label>
            <select name="reportType" class="form-control" required>
                <% if (reportTypes != null) {
                    for (ReportType rt : reportTypes) { %>
                    <option value="<%= rt.name() %>"><%= rt.getDisplayName() %></option>
                <%  }
                } %>
            </select>
        </div>
        <div class="form-group" style="flex: 1; min-width: 150px; margin-bottom: 0;">
            <label>Export Format</label>
            <select name="fileFormat" class="form-control" required>
                <option value="CSV">CSV Spreadsheet (.csv)</option>
                <option value="TXT">Plain Text Audit (.txt)</option>
            </select>
        </div>
        <div style="flex: 0 0 auto;">
            <button type="submit" class="btn btn-primary" style="padding: 10px 24px;">⚡ Generate Report</button>
        </div>
    </form>
</div>

<h3 style="color: var(--text-primary); margin-top: 30px; margin-bottom: 15px;">Generated Report Archives</h3>
<div class="table-responsive">
    <table class="data-table">
        <thead>
            <tr>
                <th>Report ID</th>
                <th>Title / Type</th>
                <th>Format</th>
                <th>Generated By</th>
                <th>Timestamp</th>
                <th>Download</th>
            </tr>
        </thead>
        <tbody>
        <% if (reports != null && !reports.isEmpty()) {
            for (QualityReport rep : reports) { %>
            <tr>
                <td style="font-family: monospace; font-weight: 700;">#RPT-<%= rep.getReportId() %></td>
                <td>
                    <div style="font-weight: 600;"><%= rep.getTitle() %></div>
                    <div style="font-size: 11px; color: var(--text-muted);"><%= rep.getReportType().getDisplayName() %></div>
                </td>
                <td><span class="badge badge-info"><%= rep.getFileFormat() %></span></td>
                <td><%= rep.getGeneratedByName() != null ? rep.getGeneratedByName() : "System" %></td>
                <td><%= DateTimeUtil.formatTimestamp(rep.getGeneratedAt()) %></td>
                <td>
                    <a href="<%= request.getContextPath() %>/reports/download?id=<%= rep.getReportId() %>" class="btn btn-secondary btn-sm">
                        📥 Download <%= rep.getFileFormat() %>
                    </a>
                </td>
            </tr>
        <%  }
        } else { %>
            <tr>
                <td colspan="6" style="text-align: center; color: var(--text-muted); padding: 30px;">No generated reports found. Create one above.</td>
            </tr>
        <% } %>
        </tbody>
    </table>
</div>

<jsp:include page="/WEB-INF/includes/footer.jsp" />
